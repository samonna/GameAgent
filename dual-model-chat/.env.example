# Copy to .env (never commit .env). Load with:  export $(grep -v '^#' .env | xargs)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# Optional: put Model B on a second provider (example: Groq)
# MODEL_B_BASE_URL=https://api.groq.com/openai/v1
# MODEL_B_API_KEY=gsk_xxxxxxxx
# MODEL_B_NAME=openai/gpt-oss-120b

# Optional: a third model as judge (defaults to Model A)
# JUDGE_NAME=...
# JUDGE_BASE_URL=...
# JUDGE_API_KEY=...
